# Copy to .env and fill in, or just run ./install.sh which generates it for you.
# Never commit the real .env.

# ── Database ─────────────────────────────────────────────────────────────────
DB_NAME=icms
DB_USER=icms_user
DB_PASSWORD=change-me-long-random
DB_ROOT_PASSWORD=change-me-long-random

# ── Application ──────────────────────────────────────────────────────────────
# Signs login tokens. Changing it logs every user out.
JWT_SECRET=change-me-at-least-32-random-characters

# Host port the web UI is published on.
APP_PORT=8080

# Leave empty when the SPA is served by the API (the default Docker setup).
# Only set this if the frontend is hosted on a different origin, e.g.
#   CORS_ORIGINS=https://icms.example.com,https://www.icms.example.com
CORS_ORIGINS=

# Read client IPs from X-Forwarded-For. Required behind nginx / a load balancer
# so the login rate limiter buckets per user instead of per proxy.
TRUST_PROXY=true
